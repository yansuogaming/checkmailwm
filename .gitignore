.vs/
.idea/
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates

# Temporary & Log Files
*.log
*.tmp
*.bak
*.cache

# OS Generated Files
Thumbs.db
Desktop.ini
.DS_Store
